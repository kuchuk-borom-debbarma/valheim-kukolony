<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable></PropertyGroup>
  <!--
    Pure decision logic is linked in here, without Unity, so it is verified in about a second
    rather than only inside a four-minute game run. Files listed here must not reference
    UnityEngine - that is the whole point, and is why the capability set lives in its own file
    apart from the registry that probes GameObjects for it.
  -->
